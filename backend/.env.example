# Django
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=ClockTower
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=ClockTower E-Menu <your-email@gmail.com>

# Order notification email (receives all new order alerts)
ORDER_NOTIFICATION_EMAIL=your-email@gmail.com

# WhatsApp Numbers (include country code without +)
WHATSAPP_ADMIN_1=255XXXXXXXXX
WHATSAPP_ADMIN_2=255XXXXXXXXX
WHATSAPP_RECEPTION=255XXXXXXXXX

# WhatsApp API (optional - for WhatsApp Business API integration)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
